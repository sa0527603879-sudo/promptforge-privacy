# Copy to .env for local use. .env is gitignored — keep it that way.
#
# Create the key in smoove: hover your account name > API Keys & pixels >
# Add API Key. Give it the narrowest permission level that the job needs
# rather than Full Permission, and restrict it to a single IP where you can.

SMOOVE_API_KEY=

# Optional. Defaults to https://rest.smoove.io/v1
# SMOOVE_BASE_URL=

# Optional. Overrides the automation-trigger path without editing send.js.
# Use {automationId} as the placeholder.
# SMOOVE_TRIGGER_PATH=/Automations/{automationId}/Trigger
